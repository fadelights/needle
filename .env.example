# API keys
OPENAI_API_KEY=sk-proj-...
HF_API_TOKEN=hf_...

# App settings
BALEQUEUE_PORT=11000

# Elasticsearch settings
ES_SCHEME=http
ES_HOST=127.0.0.1
ES_PORT=11010
ES_INDEX=documents

# Haystack settings
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
GENERATOR_PROVIDER=huggingface
GENERATOR_MODEL=mistralai/Ministral-3-3B-Instruct-2512
MAX_NEW_TOKENS=256

# Search and indexing settings
CHUNK_SIZE=8
CHUNK_OVERLAP=2
TOP_K=10
