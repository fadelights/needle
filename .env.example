# API keys
OPENAI_API_KEY=

# App settings
BALEQUEUE_PORT=11000
BALEQUEUE_HOST=localhost

# Elasticsearch settings
ES_PORT=11010
ES_HOST=127.0.0.1
ES_SCHEME=http
ES_INDEX=documents

# Haystack settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
GENERATOR_MODEL=google/flan-t5-small
MAX_NEW_TOKENS=256

# Search and indexing settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=10
