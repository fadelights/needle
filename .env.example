ENVIRONMENT=development
COMPOSE_PROJECT_NAME=needle-development # docker compose volume prefixes

# API keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-proj-...
HF_API_TOKEN=hf_...

# App settings
NEEDLE_PORT=11000

# Elasticsearch settings
ES_SCHEME=http
ES_HOST=127.0.0.1
ES_PORT=11010
ES_INDEX=documents
KIBANA_PORT=11011
ES_ANALYZER=english

# Object storage settings
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_SECURE=False
MINIO_HOST=127.0.0.1
MINIO_PORT=11020
MINIO_CONSOLE_PORT=11021

# Authentication settings
AUTH_DATABASE_URL=sqlite:///./data/needle.db
JWT_SECRET_KEY=
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Haystack settings
GENERATOR_DEVICE=cuda:0
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
GENERATOR_PROVIDER=huggingface
GENERATOR_MODEL=mistralai/Ministral-3-3B-Instruct-2512
MAX_NEW_TOKENS=256

# Search and indexing settings
SPLIT_METHOD=passage
CHUNK_SIZE=8
CHUNK_OVERLAP=2
TOP_K=10
